class StatsWindow:
    def __init__(self, parent, db, runner, rooms, topmost=True):
        self.db, self.runner, self.rooms = db, runner, rooms
        self.month = date.today().replace(day=1)
        self.data = None
        self.win = tk.Toplevel(parent)
        self.win.title("월별 진료 기록")
        self.win.geometry("780x760")
        self.win.attributes("-topmost", topmost)
        bar = tk.Frame(self.win, padx=10, pady=8)
        bar.pack(fill="x")
        tk.Button(bar, text="◀ 이전", command=lambda: self.move(-1)).pack(side="left")
        self.title = tk.Label(bar, font=(FONT, 14, "bold"))
        self.title.pack(side="left", expand=True)
        tk.Button(bar, text="다음 ▶", command=lambda: self.move(1)).pack(side="right")
        tk.Button(bar, text="이번 달", command=self.this_month).pack(side="right", padx=6)
        self.cal = tk.Frame(self.win, padx=10)
        self.cal.pack(fill="both", expand=True)
        self.selected = None
        self.detail = tk.Label(self.win, justify="left", anchor="w", font=(FONT, 9),
                               fg="#344765", wraplength=730)
        self.detail.pack(fill="x", padx=10, pady=(6, 0))
        self.summary = tk.Label(self.win, justify="left", anchor="w", font=(FONT, 10),
                                fg="#18263b", wraplength=730)
        self.summary.pack(fill="x", padx=10, pady=6)
        foot = tk.Frame(self.win, padx=10, pady=8)
        foot.pack(fill="x")
        self.win.bind("<Configure>", lambda e: (self.summary.config(wraplength=max(300, self.win.winfo_width() - 30)),
                                                self.detail.config(wraplength=max(300, self.win.winfo_width() - 30))))
        tk.Button(foot, text="일별 요약 CSV", command=self.export_daily).pack(side="left")
        tk.Button(foot, text="전체 기록 CSV", command=self.export_events).pack(side="left", padx=8)
        tk.Button(foot, text="🔎 업무별 모아보기", font=(FONT, 10, "bold"), bg="#e9f1ff",
                  command=lambda: TaskLogWindow(self.win, self.db, self.runner, 3, self.month,
                                                topmost)).pack(side="right")
        self.load()

    def move(self, off):
        m = self.month.month + off
        y = self.month.year + (m - 1) // 12
        self.month = date(y, (m - 1) % 12 + 1, 1)
        self.load()

    def this_month(self):
        self.month = date.today().replace(day=1)
        self.load()

    def load(self):
        ym = self.month.strftime("%Y-%m")
        self.title.config(text="%d년 %d월" % (self.month.year, self.month.month))
        self.summary.config(text="불러오는 중…")
        self.detail.config(text="")
        self.days = {}
        self.render_calendar()

        def fetch():
            ev = self.db.get("days", {"orderBy": '"$key"', "startAt": '"%s-01"' % ym,
                                      "endAt": '"%s-31"' % ym}) or {}
            legacy = {}
            for r in self.rooms:
                legacy[r] = self.db.get("legacy/" + r) or {}
            return ym, ev, legacy

        self.runner.submit(fetch, self.show, lambda e: self.summary.config(text="불러오기 실패: %s" % e))

    def show(self, res):
        ym, ev, legacy = res
        if ym != self.month.strftime("%Y-%m") or not self.win.winfo_exists():
            return
        days = {}
        self.calls = calls = {}
        hours = {r: [0] * 24 for r in self.rooms}
        blank = lambda: {x: [0, [0] * len(NAMES), False] for x in self.rooms}
        for day, node in (ev or {}).items():
            if not isinstance(node, dict):
                continue
            d = days.setdefault(day, blank())
            for r in self.rooms:
                d[r][1] = task_counts(node, r)
                done = dig(node, "done", r) or {}
                d[r][0] = len(done) + sum(d[r][1])
                calls.setdefault(day, {})[r] = completed_count(node, r, day, d[r][0])
                times = [v for v in done.values() if isinstance(v, dict)]
                times += [e for e in (dig(node, "events") or {}).values()
                          if isinstance(e, dict) and e.get("room") == r]
                for v in times:
                    try:
                        hours[r][int(str(v.get("time", "0"))[:2])] += 1
                    except (ValueError, AttributeError):
                        pass
        for r in self.rooms:
            for day, counts in (legacy.get(r) or {}).items():
                if not day.startswith(ym):
                    continue
                if isinstance(counts, dict):
                    counts = [counts.get(str(i), 0) for i in range(len(NAMES))]
                if not isinstance(counts, list):
                    continue
                d = days.setdefault(day, blank())
                for i, c in enumerate(counts[:len(NAMES)]):
                    if isinstance(c, int):
                        d[r][1][task_of(i)] += c
                        d[r][0] += c   # 이전 버전: 업무 1건 = 진료 완료 1명
                d[r][2] = True
        for day, info in days.items():   # 이전 버전 기록만 있는 날도 진료 완료 = 진료 카운트
            for r in self.rooms:
                if day < CALLS_SINCE:
                    calls.setdefault(day, {})[r] = info[r][0]
        self.days = days
        totals = {r: [0, [0] * len(NAMES)] for r in self.rooms}
        any_legacy = False
        for day in days:
            for r in self.rooms:
                p, t, lg = days[day][r]
                any_legacy = any_legacy or lg
                totals[r][0] += p
                totals[r][1] = [a + b for a, b in zip(totals[r][1], t)]
        self.render_calendar()
        lines = []
        for r in self.rooms:
            p, t = totals[r]
            nc = sum(c.get(r, 0) for c in calls.values())
            lines.append("%s — 진료 완료 %d명 · 진료 카운트 %d명 (업무 %d건)" % (room_label(r), nc, p, sum(t)))
            lines.append("    " + summary_text(t))
            busy = ["%d시 %d" % (h, n) for h, n in enumerate(hours[r]) if n]
            if busy:
                lines.append("    시간대별 진료 카운트: " + " · ".join(busy))
        if any_legacy:
            lines.append("* 이전 버전(v12) 기록 포함 — 업무 건수를 진료 완료 인원으로 함께 계산했습니다.")
        if not days:
            lines = ["이 달 기록이 없습니다."]
        self.summary.config(text="\n".join(lines))
        self.totals = totals

    def render_calendar(self):
        import calendar
        for w in self.cal.winfo_children():
            w.destroy()
        y, m = self.month.year, self.month.month
        for col, wd in enumerate("월화수목금토일"):
            tk.Label(self.cal, text=wd, font=(FONT, 10, "bold"),
                     fg="#b34545" if col == 6 else ("#2a5db0" if col == 5 else "#46566c")).grid(
                row=0, column=col, sticky="nsew")
            self.cal.grid_columnconfigure(col, weight=1, uniform="d")
        today_s = today()
        for wi, week in enumerate(calendar.monthcalendar(y, m), 1):
            self.cal.grid_rowconfigure(wi, weight=1, uniform="w")
            for col, d in enumerate(week):
                if not d:
                    continue
                day = "%04d-%02d-%02d" % (y, m, d)
                info = self.days.get(day)
                lines = [str(d)]
                if info:
                    if len(self.rooms) > 1:
                        for r in self.rooms:
                            p = info[r][0]
                            lines.append("%s번 %d명%s" % (STAFF_ROOM_NO.get(r, r), p, "*" if info[r][2] else ""))
                    else:
                        r = self.rooms[0]
                        lines.append("%d명%s" % (info[r][0], "*" if info[r][2] else ""))
                bg = "#fff3d6" if day == self.selected else ("#e2efff" if day == today_s else "#f7f9fd")
                tk.Button(self.cal, text="\n".join(lines), justify="left", anchor="nw",
                          font=(FONT, 9), bg=bg, relief="groove", bd=1,
                          fg="#18263b" if info else "#9aa6b8",
                          command=lambda day=day: self.show_day(day)).grid(
                    row=wi, column=col, sticky="nsew", padx=1, pady=1)

    def show_day(self, day):
        self.selected = day
        self.render_calendar()
        info = self.days.get(day)
        if not info:
            self.detail.config(text="%s 기록 없음" % day)
            return
        lines = []
        for r in self.rooms:
            p, t, lg = info[r]
            nc = getattr(self, "calls", {}).get(day, {}).get(r, 0)
            lines.append("%s %s: 진료 완료 %d명 · %s" % (day, room_label(r), nc, count_text(p)))
            lines.append("      %s%s" % (summary_text(t), "  (이전 버전 기록 포함)" if lg else ""))
        self.detail.config(text="\n".join(lines))

    def export_daily(self):
        if not getattr(self, "days", None):
            return
        import csv
        target = filedialog.asksaveasfilename(parent=self.win, defaultextension=".csv",
                                              initialfile="진료기록_%s.csv" % self.month.strftime("%Y-%m"),
                                              filetypes=[("CSV", "*.csv")])
        if not target:
            return
        with open(target, "w", newline="", encoding="utf-8-sig") as f:
            w = csv.writer(f)
            head = ["날짜"]
            for r in self.rooms:
                head += ["%s 진료완료" % room_label(r)] + ["%s %s" % (room_label(r), n) for i, n in enumerate(NAMES)
                                                         if i not in HIDDEN]
            w.writerow(head)
            for day in sorted(self.days):
                row = [day]
                for r in self.rooms:
                    p, t, _ = self.days[day][r]
                    row += [p] + t
                w.writerow(row)
        messagebox.showinfo("저장 완료", "CSV 파일을 저장했습니다.", parent=self.win)

    def export_events(self):
        import csv
        target = filedialog.asksaveasfilename(parent=self.win, defaultextension=".csv",
                                              initialfile="전체기록_%s.csv" % self.month.strftime("%Y-%m"),
                                              filetypes=[("CSV", "*.csv")])
        if not target:
            return
        ym = self.month.strftime("%Y-%m")

        def fetch():
            return self.db.get("days", {"orderBy": '"$key"', "startAt": '"%s-01"' % ym,
                                        "endAt": '"%s-31"' % ym}) or {}

        def write(days):
            rows = []
            for day, node in days.items():
                for e in (dig(node, "events") or {}).values():
                    if isinstance(e, dict) and e.get("room") in self.rooms:
                        t = e.get("task")
                        name = NAMES[task_of(t)] if isinstance(t, int) and 0 <= t < len(NAMES) else "?"
                        rows.append([day, e.get("time", ""), e.get("room"), "업무", name])
                for r in self.rooms:
                    for v in (dig(node, "done", r) or {}).values():
                        if isinstance(v, dict):
                            rows.append([day, v.get("time", ""), r, "진료 완료", ""])
            with open(target, "w", newline="", encoding="utf-8-sig") as f:
                w = csv.writer(f)
                w.writerow(["날짜", "시각", "진료실", "구분", "업무"])
                for row in sorted(rows):
                    w.writerow(row)
            messagebox.showinfo("저장 완료", "CSV 파일을 저장했습니다.", parent=self.win)

        self.runner.submit(fetch, write, lambda e: messagebox.showerror("실패", str(e), parent=self.win))
class TaskLogWindow:
    """업무 하나(예: 폐암사후)를 두 진료실 모두 모아서 언제·어느 진료실에서 했는지 보기"""
    WEEK = "월화수목금토일"

    def __init__(self, parent, db, runner, task=3, month=None, topmost=True):
        self.db, self.runner = db, runner
        self.month = month or date.today().replace(day=1)
        self.rows = []
        self.win = tk.Toplevel(parent)
        self.win.title("업무별 모아보기")
        self.win.geometry("460x620")
        self.win.attributes("-topmost", topmost)
        bar = tk.Frame(self.win, padx=10, pady=8)
        bar.pack(fill="x")
        tk.Label(bar, text="업무:", font=(FONT, 10, "bold")).pack(side="left")
        self.task = tk.StringVar(master=self.win, value=NAMES[task])
        cb = ttk.Combobox(bar, textvariable=self.task, values=[n for i, n in enumerate(NAMES) if i not in HIDDEN],
                          state="readonly", width=14)
        cb.pack(side="left", padx=4)
        cb.bind("<<ComboboxSelected>>", lambda e: self.render())
        mbar = tk.Frame(self.win, padx=10)
        mbar.pack(fill="x")
        tk.Button(mbar, text="◀", command=lambda: self.move(-1)).pack(side="left")
        self.title = tk.Label(mbar, font=(FONT, 13, "bold"))
        self.title.pack(side="left", expand=True)
        tk.Button(mbar, text="▶", command=lambda: self.move(1)).pack(side="right")
        self.summary = tk.Label(self.win, font=(FONT, 11, "bold"), fg="#18263b", justify="left", anchor="w")
        self.summary.pack(fill="x", padx=12, pady=(8, 4))
        box = tk.Frame(self.win, padx=10)
        box.pack(fill="both", expand=True)
        sb = tk.Scrollbar(box)
        sb.pack(side="right", fill="y")
        self.list = tk.Listbox(box, font=(FONT, 11), yscrollcommand=sb.set, activestyle="none")
        self.list.pack(side="left", fill="both", expand=True)
        sb.config(command=self.list.yview)
        foot = tk.Frame(self.win, padx=10, pady=8)
        foot.pack(fill="x")
        tk.Button(foot, text="CSV 저장", command=self.export).pack(side="left")
        self.load()

    def move(self, off):
        m = self.month.month + off
        y = self.month.year + (m - 1) // 12
        self.month = date(y, (m - 1) % 12 + 1, 1)
        self.load()

    def load(self):
        ym = self.month.strftime("%Y-%m")
        self.title.config(text="%d년 %d월" % (self.month.year, self.month.month))
        self.summary.config(text="불러오는 중…")
        self.list.delete(0, "end")
        self.data = None

        def fetch():
            ev = self.db.get("days", {"orderBy": '"$key"', "startAt": '"%s-01"' % ym,
                                      "endAt": '"%s-31"' % ym}) or {}
            legacy = {r: self.db.get("legacy/" + r) or {} for r in ROOMS}
            return ym, ev, legacy

        def got(res):
            if res[0] == self.month.strftime("%Y-%m") and self.win.winfo_exists():
                self.data = res
                self.render()

        self.runner.submit(fetch, got, lambda e: self.summary.config(text="불러오기 실패: %s" % e))

    def render(self):
        if not self.data:
            return
        ym, ev, legacy = self.data
        t = NAMES.index(self.task.get()) if self.task.get() in NAMES else 3
        rows = []   # (날짜, 시각, 진료실, 건수)
        for day, node in (ev or {}).items():
            for e in (dig(node, "events") or {}).values():
                if isinstance(e, dict) and task_of(e.get("task")) == t and e.get("room") in ROOMS:
                    rows.append((day, str(e.get("time", "")), e.get("room"), 1))
        for r in ROOMS:   # 이전 버전(v12) 기록은 시각 없이 건수만
            for day, counts in (legacy.get(r) or {}).items():
                if not str(day).startswith(ym):
                    continue
                if isinstance(counts, dict):
                    c = sum(v for i, v in ((int(x), y) for x, y in counts.items() if str(x).isdigit())
                            if task_of(i) == t and isinstance(v, int))
                elif isinstance(counts, list):
                    c = sum(v for i, v in enumerate(counts) if task_of(i) == t and isinstance(v, int))
                else:
                    c = 0
                if isinstance(c, int) and c > 0:
                    rows.append((day, "", r, c))
        rows.sort()
        self.rows = rows
        self.list.delete(0, "end")
        per = {r: 0 for r in ROOMS}
        last_day = None
        for day, tm, r, c in rows:
            per[r] += c
            try:
                d = datetime.strptime(day, "%Y-%m-%d")
                dlabel = "%s (%s)" % (d.strftime("%m-%d"), self.WEEK[d.weekday()])
            except ValueError:
                dlabel = day
            if last_day is not None and day != last_day:
                self.list.insert("end", "")
            last_day = day
            when = tm[:5] if tm else "시각 없음"
            self.list.insert("end", "  %s   %s   %s%s" % (dlabel, when, room_label(r),
                                                          "  %d건 (이전 버전)" % c if not tm else ""))
        total = sum(per.values())
        a, b = ROOMS
        if per[a] == per[b]:
            turn = "두 진료실 같음"
        else:
            low = a if per[a] < per[b] else b
            turn = "다음은 %s 차례 (%d건 적음)" % (room_label(low), abs(per[a] - per[b]))
        text = "%s  총 %d건   —   %s" % (
            NAMES[t], total, " · ".join("%s %d건" % (room_label(r), per[r]) for r in ROOMS))
        if t == 3:   # 다음 차례 안내는 폐암사후만 (균등 분배용)
            text += "\n→ " + turn
        self.summary.config(text=text)
        if not rows:
            self.list.insert("end", "  이 달 기록이 없습니다.")

    def export(self):
        if not self.rows:
            return
        import csv
        name = self.task.get()
        target = filedialog.asksaveasfilename(parent=self.win, defaultextension=".csv",
                                              initialfile="%s_%s.csv" % (name, self.month.strftime("%Y-%m")),
                                              filetypes=[("CSV", "*.csv")])
        if not target:
            return
        with open(target, "w", newline="", encoding="utf-8-sig") as f:
            w = csv.writer(f)
            w.writerow(["날짜", "시각", "진료실", "업무", "건수"])
            for day, tm, r, c in self.rows:
                w.writerow([day, tm, room_label(r), name, c])
        messagebox.showinfo("저장 완료", "CSV 파일을 저장했습니다.", parent=self.win)


class TaskDetail:
    """업무 하나의 상세: 오늘/이번 달/올해 건수, 마지막 기록, 오늘 시각 목록"""

    def __init__(self, parent, db, runner, room, task, topmost=True):
        self.win = tk.Toplevel(parent)
        self.win.title("%s · %s" % (room_label(room), NAMES[task]))
        self.win.geometry("380x440")
        self.win.attributes("-topmost", topmost)
        tk.Label(self.win, text="%s · %s" % (room_label(room), NAMES[task]), font=(FONT, 13, "bold")).pack(
            anchor="w", padx=14, pady=(12, 4))
        self.info = tk.Label(self.win, text="불러오는 중…", justify="left", anchor="w", font=(FONT, 11))
        self.info.pack(fill="x", padx=14)
        tk.Label(self.win, text="오늘 기록 시각", font=(FONT, 9, "bold"), fg="#46566c").pack(
            anchor="w", padx=14, pady=(10, 2))
        self.lb = tk.Listbox(self.win, font=(FONT, 10), height=10)
        self.lb.pack(fill="both", expand=True, padx=14, pady=(0, 12))
        y = date.today().year

        def fetch():
            days = db.get("days", {"orderBy": '"$key"', "startAt": '"%d-01-01"' % y,
                                   "endAt": '"%d-12-31"' % y}) or {}
            legacy = db.get("legacy/" + room) or {}
            return days, legacy

        def show(res):
            if not self.win.winfo_exists():
                return
            days, legacy = res
            d0, m0, y0 = today(), today()[:7], str(y)
            cnt = {"d": 0, "m": 0, "y": 0}
            last, times = None, []
            for day, node in days.items():
                for e in (dig(node, "events") or {}).values():
                    if isinstance(e, dict) and e.get("room") == room and task_of(e.get("task")) == task:
                        stamp = (day, e.get("time", ""))
                        last = max(last, stamp) if last else stamp
                        cnt["y"] += 1
                        cnt["m"] += day.startswith(m0)
                        if day == d0:
                            cnt["d"] += 1
                            times.append(e.get("time", ""))
            for day, v in legacy.items():
                if not day.startswith(y0):
                    continue
                c = legacy_counts(legacy_apply({}, "put", "/", v))[task]
                if c:
                    cnt["y"] += c
                    cnt["m"] += c if day.startswith(m0) else 0
                    cnt["d"] += c if day == d0 else 0
                    if not last or day > last[0]:
                        last = (day, "")
            if last:
                wd = "월화수목금토일"[date.fromisoformat(last[0]).weekday()]
                last_txt = "%s (%s) %s" % (last[0], wd, last[1][:5])
            else:
                last_txt = "기록 없음"
            self.info.config(text="오늘  %d명\n이번 달  %d명\n올해  %d명\n마지막  %s"
                                  % (cnt["d"], cnt["m"], cnt["y"], last_txt))
            for t in sorted(times, reverse=True):
                self.lb.insert(tk.END, t)
            if not times:
                self.lb.insert(tk.END, "오늘 기록 없음")

        runner.submit(fetch, show, lambda e: self.info.config(text="불러오기 실패: %s" % e))
def auto_update(stem):
    """켤 때 새 버전이 있으면 내려받아 바꾸고 다시 실행. 업데이트했으면 이 프로세스는 종료됨."""
    if not getattr(sys, "frozen", False) or BUILD_VERSION == "dev":
        return
    exe = Path(sys.executable)
    old = exe.with_name(exe.name + ".old")
    try:
        if old.exists():
            old.unlink()
    except OSError:
        pass
    try:
        req = urllib.request.Request(UPDATE_BASE + "version.txt?t=%d" % time.time(),
                                     headers={"Cache-Control": "no-cache"})
        with urllib.request.urlopen(req, timeout=5) as r:
            latest = r.read().decode("utf-8").strip()
    except Exception:
        return
    if not latest or latest == BUILD_VERSION or len(latest) < 7:
        return
    # 같은 버전으로 계속 업데이트를 반복하지 않도록 (10분에 한 번만 시도)
    guard = DATA_DIR / ("update_%s.json" % stem)
    g = load_json(guard, {})
    if g.get("target") == latest and time.time() - g.get("at", 0) < 600:
        return
    save_json(guard, {"target": latest, "at": time.time()})
    win = tk.Tk()
    win.title("업데이트")
    win.attributes("-topmost", True)
    win.geometry("320x90")
    tk.Label(win, text="새 버전으로 업데이트 중입니다…\n잠시만 기다려 주세요.", font=(FONT, 11)).pack(expand=True)
    win.update()
    new = exe.with_name(exe.name + ".new")
    try:
        # 버전별 파일 이름으로 받아서, 예전 파일이 캐시에서 내려오는 일이 없게 함
        with urllib.request.urlopen(UPDATE_BASE + "%s-%s.exe" % (stem, latest), timeout=90) as r:
            data = r.read()
        if len(data) < 1000000 or data[:2] != b"MZ":
            raise ValueError("잘못된 파일")
        new.write_bytes(data)
        os.replace(str(exe), str(old))       # 실행 중인 exe도 이름 변경은 가능
        os.replace(str(new), str(exe))
    except Exception:
        try:
            if not exe.exists() and old.exists():
                os.replace(str(old), str(exe))
            if new.exists():
                new.unlink()
        except OSError:
            pass
        win.destroy()
        return
    win.destroy()
    import subprocess
    env = dict(os.environ, PYINSTALLER_RESET_ENVIRONMENT="1")
    subprocess.Popen([str(exe)], env=env, close_fds=True,
                     creationflags=0x00000008 | 0x00000200)   # DETACHED_PROCESS | NEW_PROCESS_GROUP
    os._exit(0)


