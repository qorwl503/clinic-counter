ROUND_FONT = "ClinicRound"


def setup_fonts(root):
    """내장한 둥근 글꼴(나눔스퀘어라운드)을 이 프로그램에서만 쓰도록 등록하고 FONT를 바꿈.
    실패하면 기존 글꼴(맑은 고딕) 그대로."""
    global FONT
    from tkinter import font as tkfont
    try:
        if sys.platform == "win32" and "FONT_FILES" in globals():
            import base64, ctypes, zlib
            fdir = DATA_DIR / "fonts"
            fdir.mkdir(parents=True, exist_ok=True)
            for name, chunks in FONT_FILES.items():
                path = fdir / name
                data = zlib.decompress(base64.b64decode("".join(chunks)))
                if not path.exists() or path.stat().st_size != len(data):
                    path.write_bytes(data)
                ctypes.windll.gdi32.AddFontResourceExW(str(path), 0x10, 0)   # FR_PRIVATE: 이 프로그램만
        if ROUND_FONT in tkfont.families(root):
            FONT = ROUND_FONT
    except Exception:
        pass
    return FONT


def _round_points(x1, y1, x2, y2, r):
    r = max(1, min(r, (x2 - x1) / 2, (y2 - y1) / 2))
    return [x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r, x2, y2 - r, x2, y2, x2 - r, y2,
            x1 + r, y2, x1, y2, x1, y2 - r, x1, y1 + r, x1, y1]


class RoundButton(tk.Canvas):
    """모서리가 둥근 입체 버튼 (아래 그림자 + 누르면 살짝 내려감)"""

    def __init__(self, parent, text="", command=None, bg="#c4dafa", fg="#163a6e", shadow=None,
                 font=None, height=44, radius=12, parent_bg=None, hover=None, width=None, **_):
        pb = parent_bg or parent.cget("bg")
        super().__init__(parent, height=height, bg=pb, highlightthickness=0, bd=0, cursor="hand2",
                         width=width or 60)
        self.opt = {"text": text, "bg": bg, "fg": fg, "shadow": shadow or _darker(bg, 0.82),
                    "font": font or (FONT, 11, "bold"), "radius": radius, "hover": hover or _darker(bg, 0.94)}
        self.command = command
        self.pressed = self.inside = False
        self.bind("<Configure>", lambda e: self.draw())
        self.bind("<Enter>", lambda e: self._set(inside=True))
        self.bind("<Leave>", lambda e: self._set(inside=False, pressed=False))
        self.bind("<ButtonPress-1>", lambda e: self._set(pressed=True))
        self.bind("<ButtonRelease-1>", self._release)

    def _set(self, **kw):
        for k, v in kw.items():
            setattr(self, k, v)
        self.draw()

    def _release(self, e):
        fire = self.pressed and self.inside
        self._set(pressed=False)
        if fire and self.command:
            self.command()

    def invoke(self):
        if self.command:
            self.command()

    def draw(self):
        self.delete("all")
        w, h = max(self.winfo_width(), 20), max(self.winfo_height(), 16)
        o, r = self.opt, self.opt["radius"]
        down = 2 if self.pressed else 0
        self.create_polygon(_round_points(1, 4, w - 1, h - 1, r), smooth=True, fill=o["shadow"], outline="")
        fill = o["hover"] if self.inside else o["bg"]
        self.create_polygon(_round_points(1, 1 + down, w - 1, h - 4 + down, r), smooth=True, fill=fill, outline="")
        self.create_text(w / 2, (h - 3) / 2 + down, text=o["text"], fill=o["fg"], font=o["font"])

    def config(self, **kw):
        kw.pop("activeforeground", None)
        mine = {k: kw.pop(k) for k in list(kw) if k in ("text", "bg", "fg", "font", "shadow", "activebackground",
                                                          "command", "background", "foreground")}
        if "background" in mine:
            mine["bg"] = mine.pop("background")
        if "foreground" in mine:
            mine["fg"] = mine.pop("foreground")
        if "activebackground" in mine:
            mine["hover"] = mine.pop("activebackground")
        if "command" in mine:
            self.command = mine.pop("command")
        if "bg" in mine and "shadow" not in mine:
            mine["shadow"] = _darker(mine["bg"], 0.82)
            mine.setdefault("hover", _darker(mine["bg"], 0.94))
        changed = any(self.opt.get(k) != v for k, v in mine.items())
        self.opt.update(mine)
        if kw:
            super().config(**kw)
        if changed:
            self.draw()

    configure = config

    def cget(self, key):
        if key in ("text", "fg", "font"):
            return self.opt[key]
        if key == "bg" and "bg" in self.opt:
            return self.opt["bg"]
        return super().cget(key)


class RoundCard(tk.Canvas):
    """모서리가 둥근 흰 카드. 안쪽 내용은 .inner 프레임에 넣음"""

    def __init__(self, parent, bg="white", border="#d3dbe7", radius=14, pad=8, parent_bg=None):
        pb = parent_bg or parent.cget("bg")
        super().__init__(parent, bg=pb, highlightthickness=0, bd=0, height=40)
        self.fill, self.border, self.radius, self.pad = bg, border, radius, pad
        self.inner = tk.Frame(self, bg=bg)
        self.win = self.create_window(pad, pad, window=self.inner, anchor="nw")
        self.inner.bind("<Configure>", lambda e: self._fit())
        self.bind("<Configure>", lambda e: self._fit())

    def set_fill(self, fill, border=None):
        self.fill = fill
        if border:
            self.border = border
        self.inner.config(bg=fill)
        for c in self.inner.winfo_children():
            try:
                c.config(bg=fill)
            except tk.TclError:
                pass
        self._fit()

    def _fit(self):
        w = max(self.winfo_width(), 40)
        need = self.inner.winfo_reqheight() + 2 * self.pad
        if int(float(self.cget("height"))) != need:
            super().config(height=need)
        self.itemconfig(self.win, width=max(10, w - 2 * self.pad))
        self.delete("bgshape")
        h = max(self.winfo_height(), need)
        self.create_polygon(_round_points(1, 1, w - 1, h - 1, self.radius), smooth=True,
                            fill=self.border, outline="", tags="bgshape")
        self.create_polygon(_round_points(2, 2, w - 2, h - 2, self.radius - 1), smooth=True,
                            fill=self.fill, outline="", tags="bgshape")
        self.tag_lower("bgshape")


def _darker(color, f):
    try:
        color = color.lstrip("#")
        r, g, b = (int(color[i:i + 2], 16) for i in (0, 2, 4))
        return "#%02x%02x%02x" % (int(r * f), int(g * f), int(b * f))
    except Exception:
        return "#9aa6b8"


