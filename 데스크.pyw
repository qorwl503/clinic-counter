def task_of(t):
    """기록의 업무 번호 → 화면에서 세는 업무 번호 (합쳐진 업무 반영)"""
    return MERGED.get(t, t)


def merge_counts(counts):
    out = list(counts)
    for src, dst in MERGED.items():
        if src < len(out):
            out[dst] += out[src]
            out[src] = 0
    return out
