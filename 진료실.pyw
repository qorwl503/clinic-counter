CONFIG_FILE = DATA_DIR / "doctor.json"
OUTBOX_FILE = DATA_DIR / "doctor_outbox.json"
OLD_COUNTS = Path(os.environ.get("LOCALAPPDATA", str(Path.home()))) / "ClinicCounter" / "counts.json"
COLORS = ["#286bd5", "#0f8b7c", "#9557bd", "#c77923", "#b34d79", "#527a38", "#6576a3"]
MODS = {"없음": 0, "Ctrl": 2, "Alt": 1, "Shift": 4, "Ctrl+Alt": 3, "Ctrl+Shift": 6, "Alt+Shift": 5}
KEYS = ["없음"] + ["F%d" % i for i in range(1, 13)]
ACTIONS = [("task%d" % i, NAMES[i]) for i in range(len(NAMES))] + \
          [("call", "다음 환자 호출")]
DEFAULT_KEYS = {"task0": "F6", "task1": "F7", "task2": "F8", "task3": "F9", "task4": "F10",
                "task5": "F11", "task6": "없음", "call": "F12"}


def find_old_counts():
    """이전 버전 counts.json 위치 찾기 (Microsoft Store 파이썬은 별도 폴더에 저장됨)"""
    local = Path(os.environ.get("LOCALAPPDATA", str(Path.home())))
    found = []
    cands = [OLD_COUNTS, Path.home() / "ClinicCounter" / "counts.json"]
    try:
        cands += list((local / "Packages").glob("PythonSoftwareFoundation.Python*/LocalCache/Local/ClinicCounter/counts.json"))
    except OSError:
        pass
    for p in cands:
        try:
            if p.is_file() and p not in found:
                found.append(p)
        except OSError:
            pass
    return found


class DoctorApp:
    def __init__(self):
        self.cfg = load_json(CONFIG_FILE, {})
        self.cfg.setdefault("room", "1")
        self.cfg.setdefault("mod", "없음")
        keys = dict(DEFAULT_KEYS)
        keys.update(self.cfg.get("keys") or {})
        self.cfg["keys"] = keys
        self.outbox = load_json(OUTBOX_FILE, [])
        self.root = tk.Tk()
        self.root.title("진료실 카운터 " + VERSION + " (" + BUILD_VERSION[:7] + ")")
        self.root.geometry(self.cfg.get("geometry") or "430x700+1040+60")
        self.root.minsize(410, 640)
        self.root.configure(bg=BG)
        self.top_var = tk.BooleanVar(master=self.root, value=self.cfg.get("topmost", True))
        self.root.attributes("-topmost", self.top_var.get())
        self.runner = Runner(self.root, workers=2)
        self.sender = Runner(self.root, workers=1)   # 순서 보장 전송
        self.inbox = queue.Queue()
        self.hk_queue = queue.Queue()
        self.hotkeys = None
        self.db = None
        self.streams = []
        self.room_node = {}
        self.events = {}
        self.legacy = {}
        self.live = {}
        self.seen = {}
        self.last_call_sent = 0
        self.undo_eid = None
        self.last_msg = None
        self.events_day = None
        self.online = False
        self.sending = False
        self.flash_job = None
        self.w = {}
        self.build()
        self.connect()
        self.start_hotkeys()
        self.root.after(100, self.pump)
        self.root.after(1500, self.flush)
        self.root.after(5000, self.tick)
        self.root.protocol("WM_DELETE_WINDOW", self.close)

    @property
    def room(self):
        return self.cfg["room"]

    # ---------- 연결 ----------
    def connect(self):
        for s in self.streams:
            s.stop()
        self.streams, self.room_node, self.events, self.online, self.legacy, self.live = [], {}, {}, False, {}, {}
        self.last_msg = None
        key = self.cfg.get("key")
        if not key:
            self.db = None
            self.set_status("연결 설정 필요 — ⚙ 설정", "#a44b4b")
            self.render()
            return
        try:
            url, code = parse_key(key)
        except ValueError as e:
            self.db = None
            self.set_status(str(e), "#a44b4b")
            return
        self.db = FirebaseDB(url, code)
        self.set_status("연결 중…", "#8a6d1d")
        self.start_streams()
        self.render()

    def start_streams(self):
        for s in self.streams:
            s.stop()
        self.events_day = today()
        self.events = {}
        self.legacy = {}
        self.streams = [Stream(self.db, "live/rooms/" + self.room, self.inbox, "room"),
                        Stream(self.db, "days/" + self.events_day, self.inbox, "events"),
                        Stream(self.db, "legacy/%s/%s" % (self.room, self.events_day), self.inbox, "legacy"),
                        Stream(self.db, "live/assign", self.inbox, "assign"),
                        Stream(self.db, "live/desks", self.inbox, "desks")]
        for s in self.streams:
            s.start()

    def pump(self):
        changed = False
        try:
            while True:
                tag, ev, path, data = self.inbox.get_nowait()
                if ev == "error":
                    self.online = False
                    self.set_status("● 오프라인 — 재연결 중", "#a24b4b")
                    continue
                if not self.online:
                    self.online = True
                    self.set_status("● 연결됨", "#24824d")
                    self.root.after(200, self.flush)
                if ev == "alive":
                    continue
                if tag == "legacy":
                    self.legacy = legacy_apply(self.legacy, ev, path, data)
                elif tag in ("assign", "desks"):
                    self.live = mirror_apply(self.live, ev, "/" + tag + path.rstrip("/") if path != "/" else "/" + tag, data)
                elif tag == "room":
                    self.room_node = mirror_apply(self.room_node, ev, path, data)
                else:
                    self.events = mirror_apply(self.events, ev, path, data)
                changed = True
        except queue.Empty:
            pass
        try:
            while True:
                kind, val = self.hk_queue.get_nowait()
                if kind == "failed" and val:
                    messagebox.showwarning(
                        "단축키", "다른 프로그램이 이미 쓰고 있어 등록하지 못한 단축키:\n" + ", ".join(val) +
                        "\n\n⚙ 설정에서 다른 키나 조합키(Ctrl 등)로 바꿔주세요.", parent=self.root)
                elif kind == "key":
                    self.on_action(val)
        except queue.Empty:
            pass
        if changed:
            self.check_msg()
            self.render()
        self.root.after(100, self.pump)

    # ---------- 데스크 → 진료실 알림 ----------
    def check_msg(self):
        m = self.room_node.get("msg") if isinstance(self.room_node, dict) else None
        mid = m.get("id") if isinstance(m, dict) else ""
        if self.last_msg is None:
            if self.online:
                self.last_msg = mid
            return
        if not mid or mid == self.last_msg:
            return
        self.last_msg = mid
        if m.get("acked") or m.get("d") != today() or call_age(m) > STALE_CALL_SEC:
            return
        self.show_msg(m)

    def show_msg(self, m):
        play_sound(self.cfg.get("sound_msg") or DEFAULT_SOUNDS["msg"])
        old = getattr(self, "msg_popup", None)
        if old is not None:
            try:
                old.destroy()
            except tk.TclError:
                pass
        p = tk.Toplevel(self.root)
        self.msg_popup = p
        p.title("데스크 알림")
        p.attributes("-topmost", True)
        bg = "#fff3d6"
        p.configure(bg=bg)
        sw = p.winfo_screenwidth()
        p.geometry("420x170+%d+80" % max(0, sw // 2 - 210))
        tk.Label(p, text="📣 " + m.get("text", ""), font=(FONT, 16, "bold"), bg=bg, fg="#6b4a00",
                 wraplength=390).pack(pady=(26, 4))
        tk.Label(p, text="%s · %s" % (m.get("from", "데스크"), m.get("time", "")[:5]),
                 font=(FONT, 10), bg=bg).pack()
        mid = m.get("id")

        def ok():
            try:
                p.destroy()
            except tk.TclError:
                pass
            cur = self.room_node.get("msg") if isinstance(self.room_node, dict) else None
            if self.db and isinstance(cur, dict) and cur.get("id") == mid and not cur.get("acked"):
                self.room_node = mirror_apply(self.room_node, "put", "/msg/acked", True)
                db, room = self.db, self.room
                self.runner.submit(lambda: db.put("live/rooms/%s/msg/acked" % room, True))

        tk.Button(p, text="확인", width=12, font=(FONT, 11, "bold"), bg="#ffe08a", command=ok).pack(pady=8)
        p.protocol("WM_DELETE_WINDOW", ok)

    def set_status(self, text, color):
        self.w["net"].config(text=text, fg=color)

