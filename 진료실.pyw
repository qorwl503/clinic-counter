        self.w["pending"] = tk.Label(bottom, bg=BG, fg="#a24b4b", font=(FONT, 9))
        self.w["pending"].pack(side="left", padx=8)
        tk.Checkbutton(bottom, text="항상 위", variable=self.top_var, bg=BG,
                       command=self.toggle_top).pack(side="right")
        self.render()

    def toggle_top(self):
        self.root.attributes("-topmost", self.top_var.get())
        self.cfg["topmost"] = self.top_var.get()
        save_json(CONFIG_FILE, self.cfg)

    def key_label(self, action):
        return ""

    def waiting(self):
        return len(tickets_today(self.room_node))

    def render(self):
        self.w["title"].config(text=room_label(self.room))
        counts = [a + b for a, b in zip(task_counts(self.events, self.room), legacy_counts(self.legacy))]
        done = done_ids(self.events, self.room)
        completed = len(done) + sum(counts)
        connected = self.db is not None and (self.online or self.room_node)
        w = self.waiting()
        self.w["wait"].config(text=("대기 %d명" % w) if connected else "대기 —",
                              fg="#17539b" if self.online else "#9aa6b8")
        self.w["done"].config(text="진료 완료 %d명" % completed)
        # 대기 시간 알림: 첫 대기 환자가 5분 넘으면 주황, 10분 넘으면 빨강
        q = self.room_node.get("queue") if isinstance(self.room_node, dict) else None
        mins = []
        for t in tickets_today(self.room_node):
            m = call_age({"d": today(), "time": (q or {}).get(t, {}).get("t", "")})
            if m < 10 ** 8:
                mins.append(int(m // 60))
        top = mins[0] if mins and self.online else None
        if top is not None and top >= 5:
            red = top >= 10
            self.w["waitinfo"].config(
                text="%s 대기 %d분째" % ("🔴" if red else "🟠", top),
                fg="white", bg="#c0392b" if red else "#e08a1e")
            self.w["waitinfo"].pack(fill="x", pady=(0, 5), after=self.w["board"])
            self.w["board"].config(bg="#fde3df" if red else "#fff0d9")
            for c in self.w["board"].winfo_children():
                c.config(bg="#fde3df" if red else "#fff0d9")
        else:
            self.w["waitinfo"].pack_forget()
            self.w["board"].config(bg="#eaf2fc")
            for c in self.w["board"].winfo_children():
                c.config(bg="#eaf2fc")
        self.w["next"].pack_forget()
        if self.recall_mode():
            self.w["call"].config(text="🔁 다시 호출 (데스크 확인 전)", bg="#ffe9b8", fg="#6b4a00")
        elif connected and w > 0:
            self.w["call"].config(text="📢 다음 환자 호출", bg="#cfe3ff", fg="#12345a")
        else:
            self.w["call"].config(text="대기 환자 없음", bg="#eceff3", fg="#8a96a8")
        call = self.room_node.get("call") if isinstance(self.room_node, dict) else None
        if isinstance(call, dict) and call.get("d") == today():
            if call.get("cancelled"):
                state = "  (취소됨)"
            elif call.get("acked"):
                state = "  ✔ %s 확인" % call.get("acked")
            else:
                state = "  · 데스크 확인 전"
            self.w["callinfo"].config(text="마지막 호출 %s%s" % (call.get("time", "")[:5], state))
            if not call.get("cancelled") and call_age(call) < 300:
                self.w["cancel"].pack(side="right")
            else:
                self.w["cancel"].pack_forget()
        else:
            self.w["callinfo"].config(text="오늘 호출 없음")
            self.w["cancel"].pack_forget()
        st = self.room_node.get("staff") if isinstance(self.room_node, dict) else None
        if isinstance(st, dict) and st.get("d") == today() and call_age(st) < 1800:
            if st.get("acked"):
                self.w["staffinfo"].config(text="✔ %s 확인 (%s 호출)" % (st.get("acked"), st.get("time", "")[:5]))
                self.w["staff"].config(text="🙋 직원 호출")
            else:
                self.w["staffinfo"].config(text="%s 호출 · 데스크 확인 전" % st.get("time", "")[:5])
                self.w["staff"].config(text="🙋 직원 다시 호출")
        else:
            self.w["staffinfo"].config(text="")
            self.w["staff"].config(text="🙋 직원 호출")
        # 켜진 데스크가 하나도 없을 때만 경고 표시
        no_desk = (self.db is not None and self.online and
                   not [d for d in (dig(self.live, "desks") or {}) if desk_alive(self.live, d, self.seen)])
        if no_desk:
            self.w["recv"].config(text="⚠ 켜진 데스크가 없습니다 — 호출이 전달되지 않아요", fg="#c0392b")
            self.w["recv"].pack(fill="x", pady=(2, 2), after=self.w["staff"].master)
        else:
            self.w["recv"].pack_forget()
        for i, (key, val) in enumerate(self.w["rows"]):
            key.config(text=self.key_label("task%d" % i))
            val.config(text=str(counts[i]))
        items = []
        for eid, e in (dig(self.events, "events") or {}).items():
            if isinstance(e, dict) and e.get("room") == self.room:
                t = e.get("task")
                items.append((eid, "ev", e.get("time", ""),
                              NAMES[t] if isinstance(t, int) and 0 <= t < len(NAMES) else "?"))
        for eid in done:
            items.append((eid, "done", self.events["done"][self.room][eid].get("time", ""), "✔ 진료 완료"))
        items.sort(reverse=True)
        pend = {op["eid"] for op in self.outbox}
        lb = self.w["list"]
        sel = lb.curselection()
        lb.delete(0, tk.END)
        self.listed = items
        for eid, kind, t, label in items:
            lb.insert(tk.END, "%s    %s%s" % (t, label, "   ⏳미전송" if eid in pend else ""))
        if sel and sel[0] < lb.size():
            lb.selection_set(sel[0])
        n = len(self.outbox)
        self.w["pending"].config(text=("미전송 %d건 (연결되면 자동 전송)" % n) if n else "")

    def flash(self, text, undo_eid=None):
        self.w["msg"].config(text=text)
        self.undo_eid = undo_eid
        if undo_eid:
            self.w["undo"].pack(side="right")
        else:
            self.w["undo"].pack_forget()
        if self.flash_job:
            self.root.after_cancel(self.flash_job)
        self.flash_job = self.root.after(6000 if undo_eid else 3500, self.clear_flash)

    def clear_flash(self):
        self.w["msg"].config(text="")
        self.w["undo"].pack_forget()
        self.undo_eid = None

    def undo_last(self):
        eid = self.undo_eid
        self.clear_flash()
        if eid and (dig(self.events, "events", eid) or any(op["eid"] == eid for op in self.outbox)):
            self.remove_item(eid, "ev")
            self.flash("되돌렸습니다.")

    def tick(self):
        if self.db and self.events_day != today():
            self.start_streams()
        self.render()
        self.root.after(5000, self.tick)

    # ---------- 동작 ----------
    def on_action(self, action):
        if action == "call":
            self.call()
        elif action.startswith("task"):
            self.record(int(action[4:]))

    def need_db(self):
        if self.db is None:
            self.flash("먼저 ⚙ 설정에서 연결하세요.")
            return False
        return True

    def queue_op(self, eid, patch, mirror):
        """mirror: [(path, value)] 로컬 즉시 반영"""
        for path, value in mirror:
            if path.startswith("/rooms/"):
                continue
            if path.startswith("q:"):
                self.room_node = mirror_apply(self.room_node, "put", "/queue/" + path[2:], value)
            else:
                self.events = mirror_apply(self.events, "put", path, value)
        self.outbox.append({"eid": eid, "patch": patch})
        save_json(OUTBOX_FILE, self.outbox)
        self.render()
        self.flush()

    def record(self, task):
        if not self.need_db():
            return
        eid, day = new_id(), today()
        ev = {"room": self.room, "task": task, "time": now_hms()}
        patch, mirror = {}, []
        patch["days/%s/events/%s" % (day, eid)] = ev
        if day == self.events_day:
            mirror.append(("/events/" + eid, ev))
        self.queue_op(eid, patch, mirror)
        self.flash("✔ %s 기록 (진료 완료 +1)" % NAMES[task], undo_eid=eid)

    def unrecord(self, task):
        mine = sorted((k for k, e in (dig(self.events, "events") or {}).items()
                       if isinstance(e, dict) and e.get("room") == self.room and e.get("task") == task),
                      reverse=True)
        if mine:
            self.remove_item(mine[0], "ev")
        elif legacy_counts(self.legacy)[task] > 0:   # 이전 버전에서 올린 오늘 기록 차감
            n = legacy_counts(self.legacy)[task] - 1
            self.legacy[str(task)] = n
            self.render()
            db, path = self.db, "legacy/%s/%s/%d" % (self.room, self.events_day, task)
            self.runner.submit(lambda: db.put(path, n), fail=lambda e: self.flash("전송 실패: %s" % e))

    def delete_selected(self):
        sel = self.w["list"].curselection()
        if not sel:
            self.flash("삭제할 기록을 목록에서 먼저 선택하세요.")
            return
        eid, kind, t, label = self.listed[sel[0]]
        if messagebox.askyesno("기록 삭제", "%s  %s 기록을 삭제할까요?" % (t, label), parent=self.root):
            self.remove_item(eid, kind)

    def remove_item(self, eid, kind):
        day = self.events_day
        if kind == "ev":
            path, local = "days/%s/events/%s" % (day, eid), "/events/" + eid
            val = dig(self.events, "events", eid) or {}
        else:
            path, local = "days/%s/done/%s/%s" % (day, self.room, eid), "/done/%s/%s" % (self.room, eid)
            val = dig(self.events, "done", self.room, eid) or {}
        ticket = val.get("ticket") if isinstance(val, dict) else None
        busy = self.outbox[0] if self.sending and self.outbox else None
        pending = [op for op in self.outbox if op["eid"] == eid and op is not busy]
        if pending:  # 아직 안 보낸 기록은 그냥 취소
            self.outbox.remove(pending[0])
            mirror = [(local, None)]
            if isinstance(ticket, dict):
                mirror.append(("q:" + ticket["id"], ticket["v"]))
            for p_, v in mirror:
                if p_.startswith("q:"):
                    self.room_node = mirror_apply(self.room_node, "put", "/queue/" + p_[2:], v)
                else:
                    self.events = mirror_apply(self.events, "put", p_, v)
            save_json(OUTBOX_FILE, self.outbox)
            self.render()
            return
        patch, mirror = {path: None}, [(local, None)]
        if isinstance(ticket, dict) and isinstance(ticket.get("v"), dict) and ticket["v"].get("d") == today():
            patch["live/rooms/%s/queue/%s" % (self.room, ticket["id"])] = ticket["v"]
            mirror.append(("q:" + ticket["id"], ticket["v"]))
        self.queue_op("x" + eid, patch, mirror)

    def flush(self):
        if self.sending or not self.outbox or self.db is None:
            return
        self.sending = True
        op = self.outbox[0]
        db = self.db

        def done(_):
            self.sending = False
            if op in self.outbox:
                self.outbox.remove(op)
                save_json(OUTBOX_FILE, self.outbox)
            self.render()
            if self.outbox:
                self.root.after(50, self.flush)

        def failed(e):
            self.sending = False
            self.render()
            if "접근 거부" in str(e):
                self.set_status("● " + str(e), "#a24b4b")
            self.root.after(5000, self.flush)

        self.sender.submit(lambda: db.patch("", op["patch"]), done, failed)

    def recall_mode(self):
        """방금 한 호출을 데스크가 아직 확인 안 했으면 → 다시 호출(같은 환자)"""
        call = self.room_node.get("call") if isinstance(self.room_node, dict) else None
        return (isinstance(call, dict) and not call.get("cancelled") and not call.get("acked")
                and call_age(call) < 600)

    def call(self, force_new=False):
        if self.db is None:
            self.flash("먼저 ⚙ 설정에서 연결하세요.")
            return
        if not self.online:
            play_alert()
            self.flash("연결이 끊겨 호출할 수 없습니다.")
            return
        if time.time() - self.last_call_sent < 3:
            self.flash("방금 호출했습니다.")
            return
        again = self.recall_mode()
        if not again and self.waiting() <= 0:
            self.flash("대기 환자가 없어 호출하지 않았습니다.")
            return
        self.last_call_sent = time.time()
        db, room = self.db, self.room
        prev = self.room_node.get("call") if isinstance(self.room_node, dict) else None
        val = {"id": new_id(), "time": now_hms(), "d": today()}
        if again:
            val["repeat"] = True
        self.room_node = mirror_apply(self.room_node, "put", "/call", val)
        self.render()

        def ok(_):
            self.flash(("🔁 %s 다시 호출 보냄" if again else "📢 %s 호출 보냄") % val["time"][:5])

        def fail(e):
            self.room_node = mirror_apply(self.room_node, "put", "/call", prev)
            self.last_call_sent = 0
            play_alert()
            self.flash("호출 실패: %s" % e)
            self.render()

        self.runner.submit(lambda: db.put("live/rooms/%s/call" % room, val), ok, fail)

    def staff_call(self):
        if self.db is None or not self.online:
            play_alert()
            self.flash("연결이 끊겨 직원을 호출할 수 없습니다.")
            return
        if time.time() - getattr(self, "last_staff_sent", 0) < 3:
            self.flash("방금 직원을 호출했습니다.")
            return
        self.last_staff_sent = time.time()
        prev = self.room_node.get("staff") if isinstance(self.room_node, dict) else None
        again = isinstance(prev, dict) and not prev.get("acked") and call_age(prev) < 600
        val = {"id": new_id(), "time": now_hms(), "d": today()}
        if again:
            val["repeat"] = True
        self.room_node = mirror_apply(self.room_node, "put", "/staff", val)
        self.render()
        db, room = self.db, self.room
        self.runner.submit(lambda: db.put("live/rooms/%s/staff" % room, val),
                           lambda _: self.flash("🙋 %s 직원 호출 보냄" % val["time"][:5]),
                           lambda e: (play_alert(), self.flash("직원 호출 실패: %s" % e)))

    def cancel_call(self):
        call = self.room_node.get("call") if isinstance(self.room_node, dict) else None
        if not isinstance(call, dict) or call.get("cancelled") or self.db is None:
            return
        db, room = self.db, self.room
        patch = {"live/rooms/%s/call/cancelled" % room: True}
        tk_ = call.get("ticket")
        if (call.get("acked") and isinstance(tk_, dict) and isinstance(tk_.get("v"), dict)
                and tk_["v"].get("d") == today()):
            patch["live/rooms/%s/queue/%s" % (room, tk_["id"])] = tk_["v"]   # 이미 들여보낸 경우 대기 되돌림

        def ok(_):
            self.room_node = mirror_apply(self.room_node, "put", "/call/cancelled", True)
            if len(patch) > 1:
                self.room_node = mirror_apply(self.room_node, "put", "/queue/" + tk_["id"], tk_["v"])
            self.flash("호출을 취소했습니다." + (" (대기 +1)" if len(patch) > 1 else ""))
            self.render()

        self.runner.submit(lambda: db.patch("", patch), ok,
                           lambda e: self.flash("취소 실패: %s" % e))

    # ---------- 단축키 ----------
    def start_hotkeys(self):
        """단축키는 사용하지 않음 (EMR과 충돌) — 버튼 클릭만 사용"""
        return

    # ---------- 설정 / 기록 ----------
    def task_detail(self, task):
        if self.db is None:
            self.flash("먼저 ⚙ 설정에서 연결하세요.")
            return
        TaskDetail(self.root, self.db, self.runner, self.room, task, self.top_var.get())

    def stats(self):
        if self.db is None:
            self.flash("먼저 ⚙ 설정에서 연결하세요.")
            return
        StatsWindow(self.root, self.db, self.runner, (self.room,), self.top_var.get())

    def settings(self):
        win = tk.Toplevel(self.root)
        win.title("진료실 설정")
        win.attributes("-topmost", True)
        win.resizable(False, False)
        f = tk.Frame(win, padx=14, pady=12)
        f.pack()
        tk.Label(f, text="이 PC의 진료실", font=(FONT, 10, "bold")).grid(row=0, column=0, sticky="w")
        room = tk.StringVar(master=win, value=self.room)
        rr = tk.Frame(f)
        rr.grid(row=0, column=1, sticky="w")
        for r in ROOMS:
            tk.Radiobutton(rr, text=room_label(r), variable=room, value=r).pack(side="left")

        tk.Label(f, text="연결 키", font=(FONT, 10, "bold")).grid(row=1, column=0, sticky="w", pady=(10, 0))
        key = tk.StringVar(master=win, value=self.cfg.get("key", ""))
        tk.Entry(f, textvariable=key, width=52, font=(FONT, 8)).grid(row=1, column=1, sticky="we", pady=(10, 0))
        tk.Label(f, text="데스크 ⚙설정의 '연결 키 복사' 후 여기에 붙여넣기(Ctrl+V)", fg="#65738a",
                 font=(FONT, 8)).grid(row=2, column=1, sticky="w")

        tk.Label(f, text="데스크 알림 소리", font=(FONT, 10, "bold")).grid(row=3, column=0, sticky="w", pady=(10, 0))
        srow = tk.Frame(f)
        srow.grid(row=3, column=1, sticky="w", pady=(10, 0))
        smsg = tk.StringVar(master=win, value=self.cfg.get("sound_msg") or DEFAULT_SOUNDS["msg"])
        ttk.Combobox(srow, textvariable=smsg, values=list(SOUNDS), state="readonly", width=18).pack(side="left")
        tk.Button(srow, text="▶ 미리 듣기", command=lambda: play_sound(smsg.get())).pack(side="left", padx=6)
        nrow = 4

        def migrate():
            if self.db is None:
                messagebox.showinfo("이전 기록", "먼저 연결 키를 저장하세요.", parent=win)
                return
            found = find_old_counts()
            if not found:
                if not messagebox.askyesno(
                        "이전 기록", "이전 기록 파일을 자동으로 찾지 못했습니다.\n"
                        "counts.json 파일(또는 이전 버전의 'JSON 백업' 파일)을 직접 선택할까요?", parent=win):
                    return
                path = filedialog.askopenfilename(parent=win, filetypes=[("JSON", "*.json")])
                if not path:
                    return
                found = [Path(path)]
            rows = {}
            for path in found:
                data = load_json(path, {})
                for k, v in data.items():
                    if isinstance(v, list) and len(k) == 10 and k[4] == "-":
                        v = [int(x) if isinstance(x, int) and x > 0 else 0 for x in v][:len(NAMES)]
                        v += [0] * (len(NAMES) - len(v))
                        if sum(v) >= sum(rows.get(k, [0])):
                            rows[k] = v
            if not rows:
                messagebox.showinfo("이전 기록", "선택한 파일에 날짜별 기록이 없습니다.", parent=win)
                return
            days = sorted(rows)
            total = sum(sum(v) for v in rows.values())
            if not messagebox.askyesno("이전 기록", "이전 기록 %d일치 (%s ~ %s, 총 %d건)를\n%s 기록으로 올립니다.\n"
                                       "(같은 날짜는 최신 값으로 덮어씀) 계속할까요?"
                                       % (len(days), days[0], days[-1], total, room_label(self.room)), parent=win):
                return
            db, r = self.db, self.room
            self.runner.submit(lambda: db.patch("legacy/" + r, rows),
                               lambda _: messagebox.showinfo("완료", "이전 기록을 올렸습니다.\n📅 기록에서 확인할 수 있습니다.", parent=win),
                               lambda e: messagebox.showerror("실패", str(e), parent=win))

        tk.Button(f, text="이전 버전(v12) 기록 서버로 올리기", command=migrate).grid(
            row=nrow, column=0, columnspan=2, sticky="w", pady=(12, 0))

        def save():
            k = key.get().strip()
            if k:
                try:
                    parse_key(k)
                except ValueError as e:
                    messagebox.showerror("연결 키 오류", str(e), parent=win)
                    return
            reconnect = k != self.cfg.get("key", "") or room.get() != self.room
            self.cfg.update({"key": k, "room": room.get(), "sound_msg": smsg.get()})
            save_json(CONFIG_FILE, self.cfg)
            win.destroy()
            if reconnect:
                self.connect()
            self.start_hotkeys()
            self.render()

        b = tk.Frame(f)
        b.grid(row=nrow + 1, column=0, columnspan=2, pady=(14, 0))
        tk.Button(b, text="저장", width=10, command=save).pack(side="left", padx=4)
        tk.Button(b, text="취소", width=10, command=win.destroy).pack(side="left", padx=4)

    def close(self):
        if self.outbox and not messagebox.askyesno(
                "미전송 기록", "아직 전송 안 된 기록이 %d건 있습니다.\n종료해도 다음 실행 때 자동 전송됩니다. 종료할까요?"
                % len(self.outbox), parent=self.root):
            return
        save_json(OUTBOX_FILE, self.outbox)
        quit_now(self.root, CONFIG_FILE, self.cfg)


if __name__ == "__main__":
    app = DoctorApp()
    if os.environ.get("CLINIC_SELFTEST"):
        app.root.update()
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        (DATA_DIR / "selftest_room.txt").write_text("ok " + BUILD_VERSION, encoding="utf-8")
        os._exit(0)
    app.root.mainloop()
